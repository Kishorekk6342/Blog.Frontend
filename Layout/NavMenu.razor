@inject AuthStateService AuthState
@inject NavigationManager Navigation

@code {
    [Parameter] public bool DrawerOpen { get; set; }
}

<div style="display:flex; flex-direction:column; height:100%; width:100%;">

    <!-- CENTER MENU -->
    <div style="flex:1; display:flex; flex-direction:column; justify-content:center;">
        <MudNavMenu Dense="true">

            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">
                @if (DrawerOpen)
                {
                    <span>Feed</span>
                }
            </MudNavLink>

            <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">
                @if (DrawerOpen)
                {
                    <span>Users</span>
                }
            </MudNavLink>

            <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">
                @if (DrawerOpen)
                {
                    <span>Profile</span>
                }
            </MudNavLink>

            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
                @if (DrawerOpen)
                {
                    <span>Settings</span>
                }
            </MudNavLink>

        </MudNavMenu>
    </div>

    <!-- LOGOUT AT BOTTOM -->
    <div style="padding:8px;">
        <MudDivider Class="mb-2" />

        <MudNavLink OnClick="Logout"
                    Icon="@Icons.Material.Filled.Logout"
                    IconColor="Color.Error">
            @if (DrawerOpen)
            {
                <span>Logout</span>
            }
        </MudNavLink>
    </div>

</div>

@code {
    private async Task Logout()
    {
        await AuthState.Logout();
        Navigation.NavigateTo("/login", true);
    }
}
