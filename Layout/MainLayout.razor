@inherits LayoutComponentBase

<MudThemeProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="ml-4">Blog App</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">
            Login
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/register">
            Register
        </MudButton>
    </MudAppBar>

    <MudMainContent Class="d-flex justify-center align-center" Style="min-height:90vh">
        @Body
    </MudMainContent>

</MudLayout>
