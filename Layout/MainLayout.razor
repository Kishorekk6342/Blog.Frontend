@inherits LayoutComponentBase
@inject AuthStateService AuthState
@inject NavigationManager Nav

<MudThemeProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="ml-4">Blog App</MudText>
        <MudSpacer />

        @if (isLoggedIn)
        {
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/feed">Feed</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/write">Write</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/profile">Profile</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Logout">Logout</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">Login</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/signup">
                Sign Up
            </MudButton>
        }
    </MudAppBar>

    <MudMainContent Class="d-flex justify-center align-center" Style="min-height:90vh">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    bool isLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        isLoggedIn = await AuthState.IsLoggedIn();
    }

    async Task Logout()
    {
        await AuthState.Logout();
        Nav.NavigateTo("/login", true);
    }
}
