@using MudBlazor
@inject IDialogService DialogService

<MudPaper Elevation="2" Class="pa-4">

    <MudText Typo="Typo.h6">
        @Post.Title
    </MudText>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
        By <b>@Post.Username</b> · @Post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-3">
        @PreviewContent
    </MudText>

    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               OnClick="OpenPostDialog">
        Read More →
    </MudButton>

</MudPaper>


@code {
    [Parameter] public PostDto Post { get; set; } = default!;

    string PreviewContent =>
        Post.Content.Length > 150
            ? Post.Content[..150] + "..."
            : Post.Content;

    // ✅ MUST BE async Task
    private async Task OpenPostDialog()
    {
        var parameters = new DialogParameters
        {
            ["Post"] = Post
        };

        await DialogService.ShowAsync<PostDetailsDialog>(
            Post.Title,
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true  // ✅ Add this
            }
        );
    }
}