@using MudBlazor
@inject IDialogService DialogService

<MudCard Elevation="2" Style="overflow:hidden;">

    @* Post Image *@
    @if (!string.IsNullOrEmpty(Post.ImageUrl))
    {
        <MudImage Src="@Post.ImageUrl"
                  Style="width:100%; height:200px; object-fit:cover;" />
    }

    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
            <MudText Typo="Typo.h6" Style="flex:1">@Post.Title</MudText>
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(Post.IsPublic ? Color.Success : Color.Warning)">
                @(Post.IsPublic ? "Public" : "Private")
            </MudChip>
        </MudStack>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            By <b>@Post.Username</b> · @Post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-3">
            @PreviewContent
        </MudText>

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   OnClick="OpenPostDialog">
            Read More →
        </MudButton>
    </MudCardContent>

</MudCard>

@code {
    [Parameter] public PostDto Post { get; set; } = default!;

    string PreviewContent =>
        Post.Content.Length > 150
            ? Post.Content[..150] + "..."
            : Post.Content;

    private async Task OpenPostDialog()
    {
        var parameters = new DialogParameters { ["Post"] = Post };
        await DialogService.ShowAsync<PostDetailsDialog>(
            Post.Title,
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true
            }
        );
    }
}