@using MudBlazor
@inject IDialogService DialogService
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthStateService AuthState

<MudCard Elevation="0"
         Class="post-card pa-4"
         Style="
            border-radius:12px;
            min-height:200px;
            background:white;
            box-shadow:0 4px 16px rgba(0,0,0,0.12);
            transition:all 0.25s ease;
         ">


    <MudGrid GutterSize="4">

        <!-- LEFT IMAGE -->
        <MudItem xs="12" sm="4">
            @if (!string.IsNullOrEmpty(Post.ImageUrl))
            {
                <MudImage Src="@Post.ImageUrl"
                          Style="
                width:100%;
                height:170px;
                object-fit:cover;
                border-radius:10px;
              " />
            }
        </MudItem>

        <!-- RIGHT CONTENT -->
        <MudItem xs="12" sm="8"
                 Style="display:flex; flex-direction:column; height:100%;">

            <!-- 🔥 CONTENT BLOCK WITH SPACING -->
            <MudStack Spacing="4">

                <!-- TITLE -->
                <MudText Typo="Typo.h6" Style="font-weight:600;">
                    @Post.Title
                </MudText>

                <!-- AUTHOR -->
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    By <b>@Post.Username</b> · @Post.CreatedAt.ToString("dd MMM yyyy")
                </MudText>

                <!-- CONTENT -->
                <MudText Typo="Typo.body2" Style="color:#555;">
                    @PreviewContent
                </MudText>

            </MudStack>

            <!-- 🔥 PUSH ACTIONS TO BOTTOM -->
            <div style="margin-top:auto; padding-top:16px; padding-bottom:0px; margin-top:1px">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <!-- LEFT SIDE -->
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <!-- PUBLIC CHIP -->
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(Post.IsPublic ? Color.Success : Color.Warning)">
                            @(Post.IsPublic ? "Public" : "Private")
                        </MudChip>

                        <!-- LIKE -->
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Spacing="2">

                            <MudIconButton Size="Size.Small"
                                           Icon="@(Post.IsLiked ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                           Color="@(Post.IsLiked ? Color.Error : Color.Default)"
                                           OnClick="ToggleLike" />

                            <MudText Typo="Typo.caption">
                                @Post.LikesCount
                            </MudText>

                        </MudStack>

                    </MudStack>

                    <!-- RIGHT SIDE -->
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Style="font-weight:500; text-transform:none;"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               OnClick="OpenPostDialog">
                        Read more
                    </MudButton>

                </MudStack>

            </div>

        </MudItem>

    </MudGrid>

</MudCard>

@code {

    private string LikeColor => Post.IsLiked ? "red" : "#666";

    [Parameter] public PostDto Post { get; set; } = default!;


    string PreviewContent =>
        Post.Content.Length > 150
            ? Post.Content[..150] + "..."
            : Post.Content;

    private async Task OpenPostDialog()
    {
        var parameters = new DialogParameters { ["Post"] = Post };

        await DialogService.ShowAsync<PostDetailsDialog>(
            Post.Title,
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true
            });
    }

    // ❤️ LIKE TOGGLE
    private async Task ToggleLike()
    {
        try
        {
            var token = await AuthState.GetToken();

            var request = new HttpRequestMessage(
                HttpMethod.Post, $"api/Like/{Post.Id}");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                // ✅ instant UI update
                Post.IsLiked = !Post.IsLiked;
                Post.LikesCount += Post.IsLiked ? 1 : -1;
            }
            else
            {
                Snackbar.Add("Failed to like post", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}