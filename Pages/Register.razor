@page "/register"
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudPaper Elevation="8" Class="pa-6" Style="width:420px">

    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
        Create Account
    </MudText>

    <MudTextField @bind-Value="model.Email"
                  Label="Email"
                  Variant="Variant.Outlined"
                  FullWidth />

    <MudTextField @bind-Value="model.Password"
                  Label="Password"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  FullWidth
                  Class="mt-3" />

    <MudButton FullWidth
               Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-5"
               OnClick="HandleRegister">
        Register
    </MudButton>

</MudPaper>

@code {
    RegisterDto model = new();

    async Task HandleRegister()
    {
        var ok = await Auth.Register(model);

        if (!ok)
        {
            Snackbar.Add("Registration failed", Severity.Error);
            return;
        }

        Snackbar.Add("Account created successfully", Severity.Success);
        Nav.NavigateTo("/login");
    }
}
