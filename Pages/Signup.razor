@page "/signup"
@using Blog.Frontend.Models
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="3">
        <MudStack Spacing="3">

            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom>
                Create Account
            </MudText>

            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Sign up to start using Blog App
            </MudText>

            <MudDivider Class="my-2" />

            <!-- Username -->
            <MudTextField @bind-Value="signupDto.Username"
                          Label="Username"
                          Variant="Variant.Outlined"
                          Required
                          RequiredError="Username is required" />

            <!-- Email -->
            <MudTextField @bind-Value="signupDto.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required
                          RequiredError="Email is required" />

            <!-- Password -->
            <MudTextField @bind-Value="signupDto.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Required
                          RequiredError="Password is required" />

            <!-- Confirm Password -->
            <MudTextField @bind-Value="confirmPassword"
                          Label="Confirm Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required
                          RequiredError="Confirm your password" />

            <!-- Signup Button -->
            <MudButton FullWidth
                       Variant="Variant.Filled"
                       Style="background:#616161; color:white;"
                       Disabled="isLoading"
                       OnClick="HandleSignup">

                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate />
                    <MudText Class="ml-2">Creating account...</MudText>
                }
                else
                {
                    <MudText>Sign Up</MudText>
                }
            </MudButton>

            <!-- Login Redirect -->
            <MudStack Row="true" Justify="Justify.Center">
                <MudText Typo="Typo.body2">Already have an account?</MudText>
                <MudLink Href="/login" Class="ml-1">Sign in</MudLink>
            </MudStack>

        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private SignupDto signupDto = new();
    private string confirmPassword = string.Empty;

    private bool isLoading;
    private bool showPassword;

    private InputType passwordInputType =>
        showPassword ? InputType.Text : InputType.Password;

    private string passwordIcon =>
        showPassword
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
        => showPassword = !showPassword;

    private async Task HandleSignup()
    {
        if (signupDto.Password != confirmPassword)
        {
            Snackbar.Add("Passwords do not match", Severity.Error);
            return;
        }

        isLoading = true;
        try
        {
            var errorMessage = await AuthService.Signup(signupDto);

            if (string.IsNullOrEmpty(errorMessage))
            {
                Snackbar.Add("Account created successfully. Please login.", Severity.Success);
                Navigation.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Signup error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
