@page "/users"

@inject HttpClient Http
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
        Discover Users
    </MudText>

    <!-- Search -->
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudTextField Label="Search users..."
                      Variant="Variant.Outlined"
                      @bind-Value="searchQuery"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="SearchUsers"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </MudPaper>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Indeterminate Color="Color.Primary" />
            <MudText>Loading users...</MudText>
        </MudStack>
    }
    else if (users.Count == 0)
    {
        <MudPaper Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.PersonSearch"
                     Size="Size.Large"
                     Color="Color.Secondary" />
            <MudText Typo="Typo.h6">No users found</MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var user in users)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Style="cursor:pointer"
                             OnClick="@(() => ViewProfile(user.Id))">

                        <MudCardContent>
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">

                                <MudAvatar Size="Size.Large" Color="Color.Primary">
                                    @if (!string.IsNullOrWhiteSpace(user.ProfilePictureUrl))
                                    {
                                        <MudImage Src="@user.ProfilePictureUrl" />
                                    }
                                    else
                                    {
                                        @user.Username.Substring(0, 1).ToUpper()
                                    }
                                </MudAvatar>

                                <MudText Typo="Typo.h6">@user.Username</MudText>

                                @if (!string.IsNullOrWhiteSpace(user.Bio))
                                {
                                    <MudText Typo="Typo.body2"
                                             Align="Align.Center"
                                             Color="Color.Secondary">
                                        @user.Bio
                                    </MudText>
                                }

                            </MudStack>
                        </MudCardContent>

                        <MudCardActions Class="justify-center">
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewProfile(user.Id))"
                                       OnClick:stopPropagation>
                                View Profile
                            </MudButton>
                        </MudCardActions>

                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

@code {

    private List<UserSearchResultDto> users = new();
    private string searchQuery = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task SearchUsers()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;

        try
        {
            var token = await AuthState.GetToken();
            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var endpoint = string.IsNullOrWhiteSpace(searchQuery)
                ? "api/User/all"
                : $"api/User/search?query={Uri.EscapeDataString(searchQuery)}";

            var request = new HttpRequestMessage(HttpMethod.Get, endpoint);
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            response.EnsureSuccessStatusCode();

            users = await response.Content
                .ReadFromJsonAsync<List<UserSearchResultDto>>() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading users: {ex.Message}", Severity.Error);
            users = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewProfile(Guid userId)
    {
        Navigation.NavigateTo($"/profile/{userId}");
    }

    // ✅ LOCAL DTO (NO AMBIGUITY)
    private class UserSearchResultDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string? Bio { get; set; }
        public string? ProfilePictureUrl { get; set; }
    }
}