@page "/users"
@inject HttpClient Http
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
        Discover Users
    </MudText>

    <!-- Search Bar -->
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudTextField @bind-Value="searchQuery"
                      Label="Search users..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyUp="SearchUsers"
                      Immediate="true"
                      DebounceInterval="300" />
    </MudPaper>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText>Loading users...</MudText>
        </MudStack>
    }
    else if (users == null || !users.Any())
    {
        <MudPaper Elevation="0" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.PersonSearch" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Color="Color.Secondary">No users found</MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var user in users)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Outlined="true" Style="cursor: pointer;" OnClick="@(() => ViewProfile(user.Id))">
                        <MudCardContent>
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Large" Color="Color.Primary">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <MudImage Src="@user.ProfilePictureUrl" />
                                    }
                                    else
                                    {
                                        @user.Username?.Substring(0, 1).ToUpper()
                                    }
                                </MudAvatar>
                                <MudText Typo="Typo.h6">@user.Username</MudText>
                                @if (!string.IsNullOrEmpty(user.Bio))
                                {
                                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @user.Bio
                                    </MudText>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions Class="justify-center">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewProfile(user.Id))"
                                       OnClick:stopPropagation="true">
                                View Profile
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<UserSearchResultDto>? users;
    private string searchQuery = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            var token = await AuthState.GetToken();
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var endpoint = string.IsNullOrWhiteSpace(searchQuery)
                ? "api/User/all"
                : $"api/User/search?query={Uri.EscapeDataString(searchQuery)}";

            users = await Http.GetFromJsonAsync<List<UserSearchResultDto>>(endpoint) ?? new List<UserSearchResultDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading users: {ex.Message}", Severity.Error);
            users = new List<UserSearchResultDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchUsers()
    {
        await LoadUsers();
    }

    private void ViewProfile(Guid userId)
    {
        Navigation.NavigateTo($"/profile/{userId}");
    }

    public class UserSearchResultDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string? Bio { get; set; }
        public string? ProfilePictureUrl { get; set; }
    }
}
