@page "/"
@using Blog.Frontend.Models
@inject HttpClient Http
@inject AuthStateService AuthState
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudDivider Class="mb-4" />
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (posts.Count == 0)
    {
        <MudText Color="Color.Secondary">
            No posts available.
        </MudText>
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var post in posts)
            {
                <PostCard Post="post" />
            }
        </MudStack>
    }
</MudContainer>

@code {
    private List<PostDto> posts = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadFeed();
    }

    private async Task LoadFeed()
    {
        loading = true;

        try
        {
            var token = await AuthState.GetToken();

            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            // Try to get personalized feed (includes private posts from followed users + your own posts)
            var response = await Http.GetAsync("api/Post/feed");

            if (response.IsSuccessStatusCode)
            {
                posts = await response.Content.ReadFromJsonAsync<List<PostDto>>() ?? new();
            }
            else
            {
                // Fallback: get only public posts
                response = await Http.GetAsync("api/Post/public");
                if (response.IsSuccessStatusCode)
                {
                    posts = await response.Content.ReadFromJsonAsync<List<PostDto>>() ?? new();
                }
                else
                {
                    posts = new();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading feed: {ex.Message}", Severity.Error);
            posts = new();
        }
        finally
        {
            loading = false;
        }
    }
}
