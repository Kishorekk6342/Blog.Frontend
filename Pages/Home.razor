@page "/"
@using Blog.Frontend.Models
@inject PostService PostService
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudDivider Class="mb-4" />
    @if (loading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else if (posts.Count == 0)
    {
        <MudText Color="Color.Secondary">
            No posts available.
        </MudText>
    }
    else
    {
        <MudStack Spacing="3" Class="mt-2">
            @foreach (var post in posts)
            {
                <PostCard @key="post.Id" Post="post" />
            }
        </MudStack>
    }
</MudContainer>

@code {
    private List<PostDto> posts = new();
    private bool loading = true;



    protected override async Task OnInitializedAsync()
    {
        PostService.OnPostChanged += OnPostChanged;
        await LoadFeed(true); // ✅ only first time show loader
    }

    private void OnPostChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadFeed(false); // ❌ no loader → no flicker
        });
    }

    private async Task LoadFeed(bool showLoader = false)
    {
        if (showLoader)
        {
            loading = true;
            StateHasChanged();
        }

        try
        {
            var token = await AuthState.GetToken();
            var newPosts = await PostService.GetHomeFeed(token);

            posts = newPosts; // ✅ replace AFTER data arrives
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading feed: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    // Called by PostService event — marshals to UI thread properly
    
    public void Dispose()
    {
        PostService.OnPostChanged -= OnPostChanged;
    }
}
