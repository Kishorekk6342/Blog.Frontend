@page "/"
@using Blog.Frontend.Models
@inject PostService PostService
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-8">

    

    <MudDivider Class="mb-4" />

    <!-- 🔥 LOADING -->
    @if (loading)
    {
        <MudStack Spacing="2">
            @for (int i = 0; i < PageSize; i++)
            {
                <PostCardSkeleton />
            }
        </MudStack>
    }
    else
    {
        <!-- 🔥 EMPTY -->
        @if (posts.Count == 0)
        {
            <MudPaper Elevation="0"
                      Class="pa-10 mt-4"
                      Style="border-radius:16px;
                                     border:2px dashed #e0e0e0;
                                     background:#fafafa;
                                     text-align:center;">

                <MudIcon Icon="@Icons.Material.Outlined.Article"
                         Style="font-size:3rem; color:#bdbdbd; margin-bottom:12px;" />

                <MudText Typo="Typo.h6" Color="Color.Secondary">
                    No posts yet
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    Be the first to share something with the community.
                </MudText>

            </MudPaper>
        }
        else
        {
            <!-- 🔥 POSTS -->
            <MudStack Spacing="2" Class="mt-2">
                @foreach (var post in PagedPosts)
                {
                    <PostCard @key="post.Id" Post="post" />
                }
            </MudStack>

            <!-- 🔥 PAGINATION (ONLY HERE) -->
            @if (TotalPages > 1)
            {
                <MudDivider Class="mt-5 mb-4" />

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Wrap="Wrap.Wrap">

                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Showing @(((currentPage - 1) * PageSize) + 1)
                        –
                        @(Math.Min(currentPage * PageSize, posts.Count))
                        of @posts.Count posts
                    </MudText>

                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Disabled="@(currentPage == 1)"
                                       OnClick="PrevPage"
                                       Style="border-radius:8px;" />

                        @for (int p = 1; p <= TotalPages; p++)
                        {
                            var pageNum = p;

                            <MudButton Size="Size.Small"
                                       Variant="@(currentPage == pageNum ? Variant.Filled : Variant.Outlined)"
                                       Color="@(currentPage == pageNum ? Color.Primary : Color.Default)"
                                       OnClick="() => GoToPage(pageNum)"
                                       Style="min-width:36px; height:32px; border-radius:8px; padding:0;">
                                @pageNum
                            </MudButton>
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Disabled="@(currentPage == TotalPages)"
                                       OnClick="NextPage"
                                       Style="border-radius:8px;" />

                    </MudStack>

                </MudStack>
            }
        }
    }

</MudContainer>

@code {
    private List<PostDto> posts = new();
    private bool loading = true;

    private const int PageSize = 5;
    private int currentPage = 1;

    private int TotalPages => posts.Count == 0
        ? 1
        : (int)Math.Ceiling(posts.Count / (double)PageSize);

    private IEnumerable<PostDto> PagedPosts =>
        posts.Skip((currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        PostService.OnPostChanged += OnPostChanged;
        await LoadFeed(true);
    }

    private void OnPostChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadFeed(false);
        });
    }

    private async Task LoadFeed(bool showLoader = false)
    {
        if (showLoader)
        {
            loading = true;
            StateHasChanged();
        }

        try
        {
            var token = await AuthState.GetToken();
            var newPosts = await PostService.GetHomeFeed(token);

            posts = newPosts;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading feed: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private void PrevPage() => GoToPage(currentPage - 1);
    private void NextPage() => GoToPage(currentPage + 1);

    public void Dispose()
    {
        PostService.OnPostChanged -= OnPostChanged;
    }
}