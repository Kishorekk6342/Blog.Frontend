            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }
        );
    }


    private async Task LoadUserPosts()
    {
        if (userProfile == null) return;

        // ✅ BLOCK ONLY PRIVATE + NOT FOLLOWING
        if (!isOwnProfile && !isFollowing && userProfile.PrivateProfile)
        {
            userPosts = new List<PostDto>();
            StateHasChanged();
            return;
        }

        var postsEndpoint = isOwnProfile
            ? "api/Post/my-posts"
            : $"api/Post/user/{userProfile.Id}";

        var request = await CreateRequest(HttpMethod.Get, postsEndpoint);
        var response = await Http.SendAsync(request);

        if (response.IsSuccessStatusCode)
        {
            var newPosts = await response.Content.ReadFromJsonAsync<List<PostDto>>() ?? new();

            // ✅ OPTIONAL: filter public posts if not following
            if (!isFollowing && !isOwnProfile)
            {
                newPosts = newPosts.Where(p => p.IsPublic).ToList();
            }

            userPosts = newPosts;
        }

        StateHasChanged();
    }

