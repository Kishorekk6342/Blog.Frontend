@page "/profile"
@page "/profile/{UserId:guid}"
@inject HttpClient Http
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Blog.Frontend.Models
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject PostService PostService
@implements IDisposable


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (isLoading)
    {
        <MudPaper Class="pa-6 mb-4">

            <MudGrid>

                <!-- Avatar -->
                <MudItem xs="12" md="4" Class="d-flex justify-center">
                    <MudSkeleton Width="150px" Height="150px" Animation="Animation.Wave" />
                </MudItem>

                <!-- Profile Info -->
                <MudItem xs="12" md="8">
                    <MudStack Spacing="2">

                        <MudSkeleton Width="200px" Height="30px" Animation="Animation.Wave" />

                        <MudStack Row="true" Spacing="4">
                            <MudSkeleton Width="60px" Height="20px" />
                            <MudSkeleton Width="60px" Height="20px" />
                            <MudSkeleton Width="60px" Height="20px" />
                        </MudStack>

                        <MudSkeleton Width="100%" Height="20px" />
                        <MudSkeleton Width="80%" Height="20px" />

                    </MudStack>
                </MudItem>

            </MudGrid>

        </MudPaper>

        <!-- POSTS SKELETON -->
        <MudGrid>
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudSkeleton Height="220px" Animation="Animation.Wave" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (userProfile != null)
    {
        <MudPaper Elevation="0" Class="pa-6 mb-4">
            <MudGrid>
                <!-- Profile Picture -->
                <MudItem xs="12" md="4" Class="d-flex flex-column align-center">
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        <MudAvatar Style="width:150px;height:150px;">
                            @if (!string.IsNullOrEmpty(previewImageUrl))
                            {
                                <MudImage Src="@previewImageUrl" />
                            }
                            else if (!string.IsNullOrEmpty(currentImageUrl))
                            {
                                <MudImage Src="@currentImageUrl" />
                            }
                            else
                            {
                                <MudText Typo="Typo.h3">@GetUserInitial()</MudText>
                            }
                        </MudAvatar>

                        @if (isOwnProfile && showEditDialog)
                        {
                            <MudStack Row="true" Spacing="1" Class="mt-2">
                                <MudFileUpload T="IBrowserFile"
                                               Accept="image/*"
                                               OnFilesChanged="OnProfileImageSelected">
                                    <ActivatorContent>
                                        <MudIconButton Icon="@Icons.Material.Filled.Upload"
                                                       Color="Color.Primary" />
                                    </ActivatorContent>
                                </MudFileUpload>

                                @if (!string.IsNullOrEmpty(previewImageUrl))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Crop"
                                                   Color="Color.Secondary"
                                                   OnClick="@(() => showCropDialog = true)" />
                                }

                                @if (!string.IsNullOrEmpty(previewImageUrl))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                   Color="Color.Success"
                                                   Disabled="isSavingImage"
                                                   OnClick="SaveProfileImage">
                                        @if (isSavingImage)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        }
                                    </MudIconButton>

                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Color="Color.Error"
                                                   OnClick="CancelImageChange" />
                                }

                                @if (string.IsNullOrEmpty(previewImageUrl) && !string.IsNullOrEmpty(currentImageUrl))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   OnClick="DeleteProfileImage" />
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudItem>

                <!-- Profile Info -->
                <MudItem xs="12" md="8">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudText Typo="Typo.h4">@userProfile.Username</MudText>

                            @if (isOwnProfile)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="OpenEditDialog">
                                    Edit Profile
                                </MudButton>
                            }
                            else
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    @if (isFollowing)
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   Disabled="isFollowLoading"
                                                   OnClick="ToggleFollow">
                                            Unfollow
                                        </MudButton>
                                    }
                                    else if (followRequestPending)
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   Disabled="true">
                                            Request Sent
                                        </MudButton>
                                        <MudButton Variant="Variant.Text"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="CancelFollowRequest">
                                            Cancel
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Style="background:#616161; color:white;" Size="Size.Small"
                                                   Disabled="isFollowLoading"
                                                   OnClick="ToggleFollow">
                                            Follow
                                        </MudButton>
                                    }
                                </MudStack>
                            }
                        </MudStack>

                        <MudStack Row="true" Spacing="6">
                            <MudStack Spacing="0" Class="text-center">
                                <MudText Typo="Typo.h5"><strong>@userProfile.PostCount</strong></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">posts</MudText>
                            </MudStack>
                            <MudStack Spacing="0" Class="text-center" Style="cursor: pointer;" @onclick="ShowFollowers">
                                <MudText Typo="Typo.h5"><strong>@userProfile.FollowerCount</strong></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">followers</MudText>
                            </MudStack>
                            <MudStack Spacing="0" Class="text-center" Style="cursor: pointer;" @onclick="ShowFollowing">
                                <MudText Typo="Typo.h5"><strong>@userProfile.FollowingCount</strong></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">following</MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Spacing="1">
                            @if (!string.IsNullOrEmpty(userProfile.Bio))
                            {
                                <MudText Typo="Typo.body2">@userProfile.Bio</MudText>
                            }
                            @if (!string.IsNullOrEmpty(userProfile.Location))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" /> @userProfile.Location
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(userProfile.Website))
                            {
                                <MudLink Href="@userProfile.Website" Target="_blank" Typo="Typo.body2">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" /> @userProfile.Website
                                </MudLink>
                            }
                        </MudStack>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudDivider />

        @if (showEditDialog)
        {
            <div class="modal-backdrop">
                <MudPaper Class="modal-card pa-6">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                        Edit Profile
                    </MudText>

                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="editModel.Username"
                                      Label="Username"
                                      Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="editModel.Email"
                                      Label="Email"
                                      Variant="Variant.Outlined"
                                      Disabled="true" />
                        <MudTextField @bind-Value="editModel.Bio"
                                      Label="Bio"
                                      Variant="Variant.Outlined"
                                      Lines="4" />
                        <MudTextField @bind-Value="editModel.Location"
                                      Label="Location"
                                      Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="editModel.Website"
                                      Label="Website"
                                      Variant="Variant.Outlined" />
                    </MudStack>

                    <MudDivider Class="my-4" />

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="CloseEditDialog">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Style="background:#616161; color:white;"
                                   OnClick="SaveProfile"
                                   Disabled="isSaving">
                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>Saving...</text>
                            }
                            else
                            {
                                <text>Save</text>
                            }
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </div>
        }


        <MudPaper Elevation="0" Class="mt-4 pa-4">
            @if (userProfile!.PrivateProfile && !isOwnProfile && !isFollowing)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    🔒 This account is private.
                    @if (followRequestPending)
                    {
                        <text> Your follow request is pending approval.</text>
                    }
                    else
                    {
                        <text> Follow to see their posts.</text>
                    }
                </MudAlert>
            }

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.GridOn" /> Posts
                </MudText>
                @if (isOwnProfile)
                {
                    <MudButton Variant="Variant.Filled"
                               Style="background:#616161; color:white;"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreatePostDialog"
                               Size="Size.Small">
                        WRITE BLOG
                    </MudButton>
                }
            </MudStack>

            @if (userPosts == null || !userPosts.Any())
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Outlined.CameraAlt" Size="Size.Large" />
                    <MudText Typo="Typo.h6">No posts yet</MudText>
                    @if (isOwnProfile)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Style="background:#616161; color:white;"
                                   OnClick="OpenCreatePostDialog">
                            Create your first post
                        </MudButton>
                    }
                </MudStack>
            }
            else
            {
                <MudGrid>
                    @foreach (var post in userPosts)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard @key="post.Id" Style="overflow:hidden;">
                                @if (isOwnProfile)
                                {
                                    <div class="post-menu" @onclick:stopPropagation>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            <MudMenuItem OnClick="@(() => EditPost(post))">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                                                Edit
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="@(() => DeletePost(post.Id))">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" />
                                                Delete
                                            </MudMenuItem>
                                        </MudMenu>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(post.ImageUrl))
                                {
                                    <MudImage Src="@($"{post.ImageUrl}?v={post.Id}")"
                                              Style="width:100%; height:180px; object-fit:cover;" />
                                }

                                <MudCardContent Style="cursor:pointer" @onclick="@(() => ViewPost(post))">
                                    <MudText Typo="Typo.h6">@post.Title</MudText>
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @post.CreatedAt.ToString("MMM dd, yyyy")
                                        </MudText>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@(post.IsPublic ? Color.Success : Color.Warning)">
                                            @(post.IsPublic ? "Public" : "Private")
                                        </MudChip>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Error">Profile not found</MudAlert>
    }

    @if (showCropDialog && !string.IsNullOrEmpty(previewImageUrl))
    {
        <MudDialog Open="true" MaxWidth="MaxWidth.Small">
            <DialogContent>
                <img id="cropImage"
                     src="@previewImageUrl"
                     style="max-width:100%; max-height:400px;" />
            </DialogContent>
            <DialogActions>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CancelCrop" />
                <MudIconButton Icon="@Icons.Material.Filled.Check"
                               Color="Color.Primary"
                               OnClick="ConfirmCrop" />
            </DialogActions>
        </MudDialog>
    }
</MudContainer>

@code {
    [Parameter] public Guid? UserId { get; set; }

    private UserProfileDto? userProfile;
    private List<PostDto>? userPosts;
    private bool isLoading = true;
    private bool isOwnProfile = false;
    private bool isFollowing = false;
    private bool isFollowLoading = false;
    private bool followRequestPending = false;
    private bool showEditDialog = false;
    private bool isSaving = false;
    

    private UpdateProfileDto editModel = new();
    
    private string? currentImageUrl;
    private string? previewImageUrl;
    private bool isSavingImage = false;
    private byte[]? selectedImageBytes;
    private string? selectedImageContentType;
    private string? selectedImageName;
    private bool showCropDialog = false;


    
    
    private async Task LoadProfile()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var endpoint = UserId == null || UserId == Guid.Empty
                ? "api/User/profile"
                : $"api/User/profile/{UserId}";

            var profileRequest = await CreateRequest(HttpMethod.Get, endpoint);
            var profileResponse = await Http.SendAsync(profileRequest);

            if (profileResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            if (!profileResponse.IsSuccessStatusCode)
            {
                userProfile = null;
                return;
            }

            userProfile = await profileResponse.Content.ReadFromJsonAsync<UserProfileDto>();
            if (userProfile == null) return;

            currentImageUrl = !string.IsNullOrEmpty(userProfile.ProfilePictureUrl)
                ? $"{userProfile.ProfilePictureUrl}?v={DateTime.UtcNow.Ticks}"
                : null;

            previewImageUrl = null;
            selectedImageBytes = null;
            selectedImageName = null;
            selectedImageContentType = null;

            isOwnProfile = UserId == null || UserId == Guid.Empty;

            if (!isOwnProfile && UserId.HasValue)
                await CheckFollowStatus();

            bool canSeePosts = isOwnProfile
                || isFollowing
                || (userProfile != null && !userProfile.PrivateProfile);
            if (canSeePosts)
            {
                var postsEndpoint = isOwnProfile
                    ? "api/Post/my-posts"
                    : $"api/Post/user/{userProfile.Id}";

                var postsRequest = await CreateRequest(HttpMethod.Get, postsEndpoint);
                var postsResponse = await Http.SendAsync(postsRequest);

                userPosts = postsResponse.IsSuccessStatusCode
                    ? await postsResponse.Content.ReadFromJsonAsync<List<PostDto>>() ?? new()
                    : new();
            }
            else
            {
                userPosts = new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading profile: {ex.Message}", Severity.Error);
            userProfile = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

    }
    protected override async Task OnInitializedAsync()
    {
        PostService.OnPostChanged += OnPostChanged;

        await AuthState.InitializeAsync(); // ✅ IMPORTANT

        if (!AuthState.IsLoggedIn())
        {
            Navigation.NavigateTo("/login", replace: true); // ✅ NO BACK
            return;
        }

        await LoadProfile();
    }

    private void OnPostChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadUserPosts();
        });
    }

    private async Task OpenCreatePostDialog()
    {
        var parameters = new DialogParameters
        {
            ["Model"] = new CreatePostDto { IsPublic = true },
            ["IsEditMode"] = false
        };

        var dialog = await DialogService.ShowAsync<CreatePostDialog>(
            "Create Post",
            parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium }
        );

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var action = result.Data?.ToString();

            if (action == "created")
                Snackbar.Add("Post published successfully 🚀", Severity.Success);

            if (action == "updated")
                Snackbar.Add("Post updated successfully ✏️", Severity.Success);

            // ✅ ONLY reload posts
            await LoadUserPosts();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfile();
    }

 

  

    private async Task CheckFollowStatus()
    {
        try
        {
            var request = await CreateRequest(HttpMethod.Get, $"api/Follow/status/{UserId}");
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<FollowStatusDto>();
                isFollowing = result?.IsFollowing ?? false;

                // ✅ If profile is PUBLIC, pending request makes no sense
                // Auto-follow by sending follow request which will be converted
                if (result?.IsPending == true && userProfile?.PrivateProfile == false)
                {
                    // Profile changed to public — cancel old request and follow directly
                    await CancelPendingAndFollow();
                }
                else
                {

                    followRequestPending = result?.IsPending ?? false;
                }
            }
        }
        catch
        {
            isFollowing = false;
            followRequestPending = false;
        }
    }

    private async Task CancelPendingAndFollow()
    {
        try
        {
            // Cancel the old pending request
            var cancelReq = await CreateRequest(HttpMethod.Delete, $"api/Follow/request/{UserId}");
            await Http.SendAsync(cancelReq);

            // Now follow directly (public profile)
            var followReq = await CreateRequest(HttpMethod.Post, $"api/Follow/{UserId}");
            var followRes = await Http.SendAsync(followReq);

            if (followRes.IsSuccessStatusCode)
            {
                var result = await followRes.Content.ReadFromJsonAsync<FollowResponseDto>();
                isFollowing = result?.IsFollowing ?? false;
                followRequestPending = false;
                if (userProfile != null && isFollowing) userProfile.FollowerCount++;
            }
        }
        catch
        {
            followRequestPending = false;
        }
    }

   
    private async Task ToggleFollow()
    {
        if (!UserId.HasValue || UserId == Guid.Empty) return;
        isFollowLoading = true;

        try
        {
            if (isFollowing)
            {
                var req = await CreateRequest(HttpMethod.Delete, $"api/Follow/{UserId}");
                var res = await Http.SendAsync(req);

                if (res.IsSuccessStatusCode)
                {
                    isFollowing = false;
                    followRequestPending = false;

                    if (userProfile != null)
                        userProfile.FollowerCount--;

                    // 🔥 FIX 1: CLEAR POSTS IMMEDIATELY
                    userPosts = new List<PostDto>();

                    Snackbar.Add("Unfollowed", Severity.Success);
                    await LoadUserPosts();


                    StateHasChanged(); // 🔥 FORCE UI UPDATE

                    return; // 🔥 IMPORTANT → stop here (don't reload posts)
                }
            }
            else if (!followRequestPending)
            {
                var req = await CreateRequest(HttpMethod.Post, $"api/Follow/{UserId}");
                var res = await Http.SendAsync(req);
                if (res.IsSuccessStatusCode)
                {
                    var result = await res.Content.ReadFromJsonAsync<FollowResponseDto>();
                    if (result?.IsPending == true)
                    {
                        followRequestPending = true;
                        Snackbar.Add("Follow request sent!", Severity.Info);
                    }
                    else
                    {
                        isFollowing = true;
                        if (userProfile != null) userProfile.FollowerCount++;
                        await LoadUserPosts();
                        Snackbar.Add("Followed!", Severity.Success);
                    }
                }
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { isFollowLoading = false; StateHasChanged(); }
    }

    private async Task CancelFollowRequest()
    {
        var req = await CreateRequest(HttpMethod.Delete, $"api/Follow/request/{UserId}");
        var res = await Http.SendAsync(req);
        if (res.IsSuccessStatusCode)
        {
            followRequestPending = false;
            Snackbar.Add("Follow request cancelled", Severity.Info);
            StateHasChanged();
        }
    }

    private async Task EditPost(PostDto post)
    {
        var parameters = new DialogParameters
        {
            ["Model"] = new CreatePostDto
            {
                Title = post.Title,
                Content = post.Content,
                IsPublic = post.IsPublic
            },
            ["IsEditMode"] = true,
            ["PostId"] = post.Id
        };

        var dialog = await DialogService.ShowAsync<CreatePostDialog>(
            "Edit Post",
            parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium }
        );

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var action = result.Data?.ToString();

            if (action == "created")
                Snackbar.Add("Post published successfully 🚀", Severity.Success);

            if (action == "updated")
                Snackbar.Add("Post updated successfully ✏️", Severity.Success);

            // ✅ ONLY reload posts
            await LoadUserPosts();
        }
    }

    private async Task OnProfileImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        using var ms = new MemoryStream();
        await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);

        selectedImageBytes = ms.ToArray();
        selectedImageContentType = file.ContentType;
        selectedImageName = file.Name;
        previewImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(selectedImageBytes)}";
        showCropDialog = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showCropDialog && !string.IsNullOrEmpty(previewImageUrl))
        {
            await JS.InvokeVoidAsync("imageCropper.init", "cropImage");
        }
    }

    private void OpenCropDialog()
    {
        showCropDialog = true;
        StateHasChanged();
    }

    private async Task SaveProfileImage()
    {
        if (selectedImageBytes == null)
        {
            Snackbar.Add("Please upload an image", Severity.Warning);
            return;
        }

        isSavingImage = true;
        StateHasChanged();

        try
        {
            var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(selectedImageBytes);
            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(selectedImageContentType ?? "image/jpeg");
            content.Add(fileContent, "file", selectedImageName ?? "profile.jpg");

            var request = await CreateRequest(HttpMethod.Post, "api/User/profile-picture");
            request.Content = content;

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResultDto>();
                currentImageUrl = $"{result!.Url}?v={DateTime.UtcNow.Ticks}";
                if (userProfile != null)
                {
                    userProfile.ProfilePictureUrl = currentImageUrl;
                }
                PostService.NotifyUserProfileChanged(); // ✅ ADD HERE

                selectedImageBytes = null;
                showEditDialog = false;
                Snackbar.Add("Profile picture updated", Severity.Success);
            }
            else
            {
                Snackbar.Add("Image upload failed", Severity.Error);
            }
        }
        finally
        {
            isSavingImage = false;
            StateHasChanged();
        }
    }

    private async Task DeletePost(Guid postId)
    {
        try
        {
            var request = await CreateRequest(HttpMethod.Delete, $"api/Post/{postId}");
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Post deleted successfully", Severity.Success);
                if (userPosts != null)
                {
                    var removed = userPosts.RemoveAll(p => p.Id == postId);
                    if (removed > 0 && userProfile != null)
                        userProfile.PostCount--;
                }
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Delete failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void CancelImageChange()
    {
        previewImageUrl = null;
        selectedImageBytes = null;
        selectedImageName = null;
        selectedImageContentType = null;
        showEditDialog = false;
    }

    private async Task DeleteProfileImage()
    {
        try
        {
            var request = await CreateRequest(HttpMethod.Delete, "api/User/profile-picture");
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                currentImageUrl = null;
                if (userProfile != null)
                {
                    userProfile.ProfilePictureUrl = currentImageUrl;
                }
                selectedImageBytes = null;
                selectedImageName = null;
                selectedImageContentType = null;
                Snackbar.Add("Profile picture deleted", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Delete failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmCrop()
    {
        var base64 = await JS.InvokeAsync<string>("imageCropper.crop", 300);
        if (string.IsNullOrEmpty(base64)) return;

        selectedImageBytes = Convert.FromBase64String(base64.Split(',')[1]);
        selectedImageContentType = "image/jpeg";
        selectedImageName = "profile.jpg";
        previewImageUrl = base64;
        currentImageUrl = base64;
        showCropDialog = false;
        await JS.InvokeVoidAsync("imageCropper.destroy");
    }

    private async Task CancelCrop()
    {
        showCropDialog = false;
        previewImageUrl = null;
        selectedImageBytes = null;
        selectedImageName = null;
        selectedImageContentType = null;
        await JS.InvokeVoidAsync("imageCropper.destroy");
    }

   

   

   
    private void OpenEditDialog()
    {
        editModel = new UpdateProfileDto
        {
            Username = userProfile?.Username ?? "",
            Email = userProfile?.Email ?? "",
            Bio = userProfile?.Bio ?? "",
            Location = userProfile?.Location ?? "",
            Website = userProfile?.Website ?? ""
        };
        showEditDialog = true;
        StateHasChanged();
    }

    private void CloseEditDialog()
    {
        showEditDialog = false;
        previewImageUrl = null;
        selectedImageBytes = null;
        selectedImageName = null;
        selectedImageContentType = null;
    }

    private async Task SaveProfile()
    {
        isSaving = true;
        try
        {
            var request = await CreateRequest(HttpMethod.Put, "api/User/profile");
            request.Content = JsonContent.Create(editModel);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Profile updated successfully!", Severity.Success);
                PostService.NotifyUserProfileChanged(); // ✅ ADD THIS
                CloseEditDialog();
                await LoadProfile();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<HttpRequestMessage> CreateRequest(HttpMethod method, string url)
    {
        var request = new HttpRequestMessage(method, url);
        var token = await AuthState.GetToken();
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return request;
    }

